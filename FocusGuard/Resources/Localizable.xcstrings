                      "state" : "translated",
                      "value" : "%arg minutes"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "It's saved as %lld minutes. %@ has no passes. “It's for work” opens after %lld seconds, for sites that really are work." : {
