        }
      }
    },
    "The browser extension is free: sharper tracking, and tabs pause straight away. Pro adds blocking before pages load. Adding it never starts a trial." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauzer genişləndirməsi pulsuzdur: izləmə daha dəqiq olur, tablar dərhal dayandırılır. Pro səhifələri yüklənməzdən əvvəl bloklama imkanı əlavə edir. Genişləndirməni əlavə etmək heç vaxt sınaq müddətini başlatmır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Browser-Erweiterung ist kostenlos: genaueres Tracking, und Tabs pausieren sofort. Pro blockiert zusätzlich schon, bevor Seiten laden. Das Hinzufügen startet nie eine Testphase."
          }
        }
      }
    },
    "The browser extension stops it before it opens." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Brauzer genişləndirməsi açılmazdan əvvəl onun qarşısını alır."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Browsererweiterung stoppt sie, bevor sie sich öffnet."
          }
        }
      }
    },
    "The day in numbers" : {
