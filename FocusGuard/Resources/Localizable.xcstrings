    },
    "Your activity is stored on this Mac. FocusGuard goes online only to check for updates, to fetch site icons from the sites themselves, and for Spotify, Todoist, Linear, GitHub and Jira when you use them." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fəaliyyətiniz bu Mac-də saxlanılır. FocusGuard internetə yalnız yeniləmələri yoxlamaq, sayt ikonlarını saytların özündən almaq, bir də istifadə etdiyiniz zaman Spotify, Todoist, Linear, GitHub və Jira üçün qoşulur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aktivität wird auf diesem Mac gespeichert. FocusGuard geht nur online, um nach Updates zu suchen, um Website-Symbole direkt von den Websites zu laden, und für Spotify, Todoist, Linear, GitHub und Jira, wenn du sie nutzt."
          }
        }
      }
    },
    "Your activity is stored on this Mac. FocusGuard goes online only to check for updates, to fetch site icons from the sites themselves, and for Spotify, Todoist, Linear, GitHub, Jira and Slack when you use them." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fəaliyyətiniz bu Mac-də saxlanılır. FocusGuard internetə yalnız yeniləmələri yoxlamaq, sayt ikonlarını saytların özündən almaq, bir də istifadə etdiyiniz zaman Spotify, Todoist, Linear, GitHub, Jira və Slack üçün qoşulur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aktivität wird auf diesem Mac gespeichert. FocusGuard geht nur online, um nach Updates zu suchen, um Website-Symbole direkt von den Websites zu laden, und für Spotify, Todoist, Linear, GitHub, Jira und Slack, wenn du sie nutzt."
          }
        }
      }
    },
    "Your activity is stored on this Mac. FocusGuard goes online only to check for updates, to fetch site icons from the sites themselves, for Spotify, Todoist, Linear, GitHub and Jira when you use them, and for AI tips, which send a short summary (never window titles or full URLs) when you ask." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fəaliyyətiniz bu Mac-də saxlanılır. FocusGuard internetə yalnız yeniləmələri yoxlamaq, sayt ikonlarını saytların özündən almaq, istifadə etdiyiniz zaman Spotify, Todoist, Linear, GitHub və Jira üçün, həmçinin siz istədikdə qısa xülasə (heç vaxt pəncərə başlıqları və ya tam URL-lər deyil) göndərən süni intellekt məsləhətləri üçün qoşulur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Aktivität wird auf diesem Mac gespeichert. FocusGuard geht nur online, um nach Updates zu suchen, um Website-Symbole direkt von den Websites zu laden, für Spotify, Todoist, Linear, GitHub und Jira, wenn du sie nutzt, und für KI-Tipps, die eine kurze Zusammenfassung senden (nie Fenstertitel oder vollständige URLs), wenn du darum bittest."
          }
        }
      }
    },
    "Your activity is stored on this Mac. FocusGuard goes online only to check for updates, to fetch site icons from the sites themselves, for Spotify, Todoist, Linear, GitHub, Jira and Slack when you use them, and for AI tips, which send a short summary (never window titles or full URLs) when you ask." : {
