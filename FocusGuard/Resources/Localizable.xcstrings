    "%@ will say the extension can “read your browsing history”. It only checks each address against your rules, on this Mac, and never reads what's on the page." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ genişləndirmənin “baxış tarixçənizi oxuya bildiyini” deyəcək. O, yalnız hər ünvanı bu Mac-də qaydalarınızla yoxlayır və səhifədəki məzmunu heç vaxt oxumur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wird sagen, dass die Erweiterung „deinen Browserverlauf lesen“ kann. Sie prüft aber nur jede Adresse auf diesem Mac anhand deiner Regeln und liest nie, was auf der Seite steht."
          }
        }
      }
    },
