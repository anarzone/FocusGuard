    },
    "FocusGuard asks Slack for two things only: to change your status and to pause your notifications. It can't read your messages or channels." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FocusGuard Slack-dən yalnız iki şey istəyir: statusunuzu dəyişmək və bildirişlərinizi dayandırmaq. Mesajlarınızı və kanallarınızı oxuya bilmir."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FocusGuard bittet Slack nur um zwei Dinge: deinen Status zu ändern und deine Mitteilungen zu pausieren. Deine Nachrichten und Channels kann es nicht lesen."
          }
        }
      }
    },
    "FocusGuard can't see any repositories yet" : {
      "localizations" : {
