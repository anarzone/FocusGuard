    "That's against %@ on other days. %@ takes %@ of it." : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digər günlərdə isə %1$@. Bunun %3$@ hissəsini %2$@ tutur."
