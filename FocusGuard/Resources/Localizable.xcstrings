    "Issues assigned to you, moved to done when you finish" : {
      "localizations" : {
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sizə təyin olunmuş tapşırıqlar, bitirəndə “Done” statusuna keçir"
