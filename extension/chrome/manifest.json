{
  "manifest_version": 3,
  "name": "FocusGuard",
  "short_name": "FocusGuard",
  "description": "Works with FocusGuard for Mac: counts your time site by site and pauses distracting tabs while you focus. Stays on your Mac.",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "FocusGuard",
    "default_popup": "pages/popup.html",
    "default_icon": {
      "16": "icons/toolbar16.png",
      "32": "icons/toolbar32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "options_page": "pages/options.html",
  "permissions": [
    "tabs",
    "nativeMessaging",
    "storage",
    "alarms",
    "declarativeNetRequestWithHostAccess"
  ],
  "optional_permissions": [
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["pages/block.html", "pages/block.css", "pages/block.js", "pages/common.css", "src/lib/*.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "incognito": "spanning"
}
